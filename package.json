{
	"name": "tempo-api",
	"version": "0.0.1",
	"description": "",
	"author": "",
	"private": true,
	"license": "UNLICENSED",
	"engines": {
		"node": "^20.19.0 || ^22.13.0 || >=24.0.0",
		"npm": ">=10.8.2"
	},
	"scripts": {
		"build": "rimraf dist && nest build",
		"format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
		"format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\"",
		"start": "docker compose -p tempo-api-development -f docker-compose.dev.yml --env-file .env.development up -d && nest start",
		"start:dev": "docker compose -p tempo-api-development -f docker-compose.dev.yml --env-file .env.development up -d && rimraf dist && nest start --watch",
		"start:debug": "docker compose -p tempo-api-development -f docker-compose.dev.yml --env-file .env.development up -d && rimraf dist && nest start --debug --watch",
		"lint": "eslint \"{src,test}/**/*.ts\" --fix",
		"lint:check": "eslint \"{src,test}/**/*.ts\"",
		"test": "jest --passWithNoTests",
		"test:watch": "jest --watch",
		"test:cov": "jest --coverage",
		"test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest",
		"docker:test:up": "docker compose -p tempo-api-test -f docker-compose.test.yml --env-file .env.test up --wait",
		"docker:test:down": "docker compose -p tempo-api-test -f docker-compose.test.yml --env-file .env.test down -v --remove-orphans",
		"test:e2e": "npm run docker:test:down && npm run docker:test:up && rimraf dist && jest --config ./test/jest-e2e.json --verbose --runInBand",
		"test:e2e:cov": "npm run docker:test:down && npm run docker:test:up && rimraf dist && jest --config ./test/jest-e2e.json --verbose --coverage --runInBand",
		"db:seed": "ts-node -r tsconfig-paths/register ./scripts/seed.ts",
		"db:schema": "ts-node -r tsconfig-paths/register ./scripts/schema.ts"
	},
	"dependencies": {
		"@nest-lab/throttler-storage-redis": "^1.2.0",
		"@nestjs-modules/mailer": "^2.3.7",
		"@nestjs/bullmq": "^11.0.5",
		"@nestjs/common": "^11.2.3",
		"@nestjs/config": "^4.0.4",
		"@nestjs/core": "^11.2.3",
		"@nestjs/event-emitter": "^12.0.1",
		"@nestjs/passport": "^11.0.5",
		"@nestjs/platform-express": "^11.2.6",
		"@nestjs/swagger": "^11.4.7",
		"@nestjs/terminus": "^11.1.1",
		"@nestjs/throttler": "^6.7.0",
		"@nestjs/typeorm": "^11.0.3",
		"argon2": "^0.45.1",
		"bullmq": "^6.3.4",
		"class-transformer": "^0.5.1",
		"class-validator": "^0.15.1",
		"connect-redis": "^8.1.0",
		"express-session": "^1.19.0",
		"fast-geoip": "^1.1.88",
		"handlebars": "^4.7.9",
		"helmet": "^8.3.0",
		"ioredis": "^5.11.1",
		"ms": "^2.1.3",
		"nodemailer": "10.0.10",
		"openai": "7.20.0",
		"passport": "^0.7.0",
		"passport-local": "^1.0.0",
		"pg": "^8.23.0",
		"reflect-metadata": "^0.2.0",
		"rimraf": "^6.1.3",
		"rxjs": "^7.8.1",
		"typeorm": "^0.3.31",
		"ua-parser-js": "^1.0.41",
		"zod": "^4.5.4"
	},
	"devDependencies": {
		"@faker-js/faker": "^9.1.0",
		"@nestjs/cli": "^12.0.3",
		"@nestjs/schematics": "^11.1.0",
		"@nestjs/testing": "^11.2.3",
		"@trivago/prettier-plugin-sort-imports": "^6.0.2",
		"@types/express": "^5.0.6",
		"@types/express-session": "^1.19.0",
		"@types/jest": "^30.0.0",
		"@types/ms": "^2.1.0",
		"@types/node": "^20.19.43",
		"@types/nodemailer": "^8.0.1",
		"@types/passport-local": "^1.0.38",
		"@types/supertest": "^7.2.1",
		"@types/ua-parser-js": "^0.7.39",
		"@typescript-eslint/eslint-plugin": "^8.69.0",
		"@typescript-eslint/parser": "^8.70.1",
		"eslint": "^10.12.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-prettier": "^5.5.6",
		"jest": "^30.5.2",
		"prettier": "^3.9.6",
		"source-map-support": "^0.5.21",
		"supertest": "^7.2.2",
		"ts-jest": "^29.4.12",
		"ts-loader": "^9.6.2",
		"ts-node": "^10.9.2",
		"tsconfig-paths": "^4.2.0",
		"typescript": "^5.9.3"
	},
	"jest": {
		"moduleNameMapper": {
			"^@core/(.*)$": "<rootDir>/src/app/core/$1",
			"^@modules/(.*)$": "<rootDir>/src/app/modules/$1"
		},
		"moduleFileExtensions": [
			"js",
			"json",
			"ts"
		],
		"rootDir": ".",
		"testMatch": [
			"<rootDir>/src/**/*.spec.ts"
		],
		"transform": {
			"^.+\\.(t|j)s$": "ts-jest"
		},
		"collectCoverageFrom": [
			"src/**/*.{!(module|repository.module),}.(t|j)s"
		],
		"coverageDirectory": "./coverage",
		"testEnvironment": "node"
	},
	"overrides": {
		"preview-email": {
			"mailparser": "3.9.28",
			"nodemailer": "$nodemailer"
		}
	}
}
