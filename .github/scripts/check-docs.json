{
  "docs": [
    "**/README.md",
    "**/AGENTS.md",
    "**/PRODUCT.md",
    "**/DESIGN.md",
    "**/docs/**/*.md"
  ],
  "extensions": [
    ".ts",
    ".tsx",
    ".js",
    ".jsx",
    ".mjs",
    ".cjs",
    ".json",
    ".md",
    ".sh",
    ".py",
    ".yml",
    ".yaml",
    ".css",
    ".html",
    ".sql",
    ".toml"
  ],
  "budgets": [
    {
      "pattern": "README.md",
      "words": 300
    },
    {
      "pattern": "AGENTS.md",
      "words": 1000
    },
    {
      "pattern": "apps/*/AGENTS.md",
      "words": 1400
    },
    {
      "pattern": "**/DESIGN.md",
      "words": 3500
    },
    {
      "pattern": "**/PRODUCT.md",
      "words": 1200
    },
    {
      "pattern": "ops/README.md",
      "words": 2500
    }
  ],
  "defaultBudget": 2500,
  "overrides": {
    "apps/web/DESIGN.md": {
      "words": 4000,
      "reason": "the design system's single document: colour layers, the type and size scale, and every shared component's variants"
    },
    "apps/api/docs/banking-invariants.md": {
      "words": 4500,
      "reason": "every remaining line is a banking invariant that no test or other doc states"
    },
    "apps/api/docs/file-import.md": {
      "words": 2800,
      "reason": "the statement import and its column mapper end to end; each line is a current rule of that pipeline that no other doc states"
    }
  },
  "allowMissing": [
    {
      "paths": [
        "**/dist/**"
      ],
      "reason": "build output, created by the build and git-ignored"
    },
    {
      "paths": [
        "**/coverage/**",
        "**/test-results/**",
        "**/playwright-report/**"
      ],
      "reason": "test output, git-ignored"
    },
    {
      "paths": [
        "apps/web/src/routeTree.gen.ts"
      ],
      "reason": "generated by the router plugin (generate-routes) and git-ignored"
    },
    {
      "paths": [
        "ops/staging/staging.compose.yml"
      ],
      "docs": [
        "ops/staging/README.md"
      ],
      "reason": "the name ops/install.sh staging installs ops/staging/docker-compose.yml under"
    },
    {
      "paths": [
        "ghcr.io/**"
      ],
      "reason": "container image names, not paths"
    },
    {
      "paths": [
        "@/**",
        "@core/**",
        "@modules/**"
      ],
      "docs": [
        "apps/web/**",
        "apps/api/**"
      ],
      "reason": "TypeScript import aliases (@/ in the web app, @core/ and @modules/ in the API)"
    },
    {
      "paths": [
        "package.json"
      ],
      "docs": [
        "README.md",
        "AGENTS.md"
      ],
      "reason": "names each app's package.json, not one file"
    },
    {
      "paths": [
        "apps/web/docs/sw.js"
      ],
      "docs": [
        "apps/web/docs/pwa.md"
      ],
      "reason": "the service worker the build emits"
    },
    {
      "paths": [
        "apps/web/docs/page.goto('/login')"
      ],
      "docs": [
        "apps/web/docs/env-boundaries.md"
      ],
      "reason": "a Playwright call, not a path"
    },
    {
      "paths": [
        "CI/CD",
        "8/8"
      ],
      "docs": [
        "docs/ci-and-images.md"
      ],
      "reason": "the workflow name and a shard label, not paths"
    },
    {
      "paths": [
        "use-x.ts"
      ],
      "docs": [
        "apps/web/AGENTS.md"
      ],
      "reason": "an example file name for a naming rule"
    }
  ]
}
