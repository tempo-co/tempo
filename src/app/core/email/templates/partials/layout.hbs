<!DOCTYPE html>
<html>
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="color-scheme" content="light dark">
    <meta name="supported-color-schemes" content="light dark">
    <title>{{subject}}</title>
    <style type="text/css">
      :root { color-scheme: light dark; supported-color-schemes: light dark; }
      h1, h2, p { margin-top: 0; }
      h1 {
        color: #28252B;
        font-size: 24px;
        font-weight: 600;
        line-height: 1.25;
        margin-bottom: 24px;
      }
      h2 {
        color: #28252B;
        font-size: 18px;
        font-weight: 600;
        line-height: 1.35;
        margin-bottom: 16px;
      }
      p {
        color: #28252B;
        font-size: 16px;
        line-height: 1.5;
        margin-bottom: 16px;
      }
      p:last-of-type { margin-bottom: 0; }

      @media (prefers-color-scheme: dark) {
        h1, h2, p, .email-text { color: #F0EBE2 !important; }
        .email-card { background-color: #201E24 !important; border-color: #3A363E !important; }
        .email-code { background-color: #2A272E !important; border-color: #3A363E !important; color: #F0EBE2 !important; }
        .email-button { background-color: #E59A7B !important; color: #17161B !important; }
        a.email-link { color: #E59A7B !important; }
        p.email-muted { color: #B5AFA6 !important; }
      }

      [data-ogsc] h1, [data-ogsc] h2, [data-ogsc] p, [data-ogsc] .email-text { color: #F0EBE2 !important; }
      [data-ogsb] .email-card { background-color: #201E24 !important; border-color: #3A363E !important; }
      [data-ogsb] .email-code { background-color: #2A272E !important; border-color: #3A363E !important; }
      [data-ogsc] .email-code { color: #F0EBE2 !important; }
      [data-ogsb] .email-button { background-color: #E59A7B !important; }
      [data-ogsc] .email-button { color: #17161B !important; }
      [data-ogsc] a.email-link { color: #E59A7B !important; }
      [data-ogsc] p.email-muted { color: #B5AFA6 !important; }
    </style>
  </head>
  <body
    style="margin:0;padding:0;font-family:Inter,-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;color:#28252B;"
  >
    <div
      class="email-preheader"
      style="display:none;max-height:0;max-width:0;overflow:hidden;opacity:0;font-size:1px;line-height:1px;mso-hide:all;"
    >
      {{preheader}}
      <!-- Padding keeps clients from filling the inbox preview with body text. -->
      &#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;
    </div>
    <table
      role="presentation"
      border="0"
      cellpadding="0"
      cellspacing="0"
      width="100%"
      style="width:100%;border-collapse:collapse;"
    >
      <tr>
        <td align="center" style="padding:32px 16px;">
          <table
            role="presentation"
            border="0"
            cellpadding="0"
            cellspacing="0"
            width="500"
            align="center"
            bgcolor="#FBF8F1"
            class="email-card"
            style="width:100%;max-width:500px;border:1px solid #D0C8B9;border-collapse:collapse;background-color:#FBF8F1;"
          >
            <tr>
              <td class="email-text" style="padding:24px;line-height:1.5;color:#28252B;">
                {{> @partial-block }}
              </td>
            </tr>
          </table>
          <p
            class="email-muted"
            style="max-width:500px;margin:16px auto 0;font-size:12px;line-height:1.5;color:#6E675E;text-align:center;"
          >
            Sent by Tempo because of activity on your account. Need help? Reply to this email.
          </p>
        </td>
      </tr>
    </table>
  </body>
</html>
