{{#> layout
    subject="Confirm your new Tempo email"
    preheader=(concat "Confirm this address to finish changing your Tempo email. The link expires in " expiration ".")
}}
  <h1>Confirm your new email</h1>
  <p>You asked to use this address for your Tempo account. Confirm it to finish the change.</p>
  {{> button
      url=verificationUrl
      text="Confirm email"
      bgColor="#8F4032"
      textColor="#F6F1E8"
  }}
  <p>This link expires in {{expiration}}. Your current email keeps working until you confirm.</p>
  <p>If you didn't ask for this, you can ignore this email.</p>
{{/layout}}
