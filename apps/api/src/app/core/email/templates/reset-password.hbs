{{#> layout
    subject="Reset your Tempo password"
    preheader=(concat "Choose a new password. The link expires in " expiration ".")
}}
  <h1>Reset your Tempo password</h1>
  <p>You asked to reset your Tempo password. Use the button below to choose a new one.</p>
  {{> button
      url=resetUrl
      text="Reset password"
      bgColor="#8F4032"
      textColor="#F6F1E8"
  }}
  <p>This link expires in {{expiration}}.</p>
  <p>If you didn't ask for this, you can ignore this email. Your password stays the same.</p>
{{/layout}}
