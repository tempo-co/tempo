<table role="presentation" border="0" cellpadding="0" cellspacing="0" width="100%" style="margin: 24px 0;">
  <tr>
    <td align="left">
      <a href="{{url}}" class="email-button" style="
        background-color: {{bgColor}};
        color: {{textColor}};
        padding: 8px 16px;
        text-decoration: none;
        border-radius: 0;
        display: inline-block;
        font-family: Inter, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
        font-size: 14px;
        line-height: 20px;
        text-align: center;
        font-weight: 500;
      ">
        {{text}}
      </a>
    </td>
  </tr>
</table>
<p class="email-muted email-fallback" style="font-size:14px;line-height:1.5;color:#6E675E;">
  If the button doesn't work, copy this link into your browser:<br>
  <a href="{{url}}" class="email-link" style="color:#8F4032;word-break:break-all;">{{url}}</a>
</p>
