{
	"name": "@tempo/local-mcp",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"engines": {
		"node": ">=22.13.0"
	},
	"scripts": {
		"build": "node scripts/generate-categories.mjs && tsc -p tsconfig.json",
		"start": "node dist/stdio.js",
		"test": "npm run build && node --test test/*.test.mjs",
		"lint:check": "eslint src test scripts",
		"format:check": "prettier --check src test scripts *.json *.mjs",
		"smoke:api": "npm run build && node scripts/smoke-api.mjs"
	},
	"dependencies": {
		"@modelcontextprotocol/sdk": "1.32.1",
		"validator": "13.15.35",
		"zod": "4.6.7"
	},
	"devDependencies": {
		"@types/node": "^22.20.5",
		"@types/validator": "^13.15.10",
		"eslint": "^10.12.0",
		"prettier": "^3.9.10",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.71.1"
	}
}
