[Unit]
Description=Tempo staging rootless Docker daemon

[Service]
Environment=PATH=%h/bin:%h/.local/bin:/usr/local/bin:/usr/local/sbin:/usr/sbin:/usr/bin:/sbin:/bin
Environment=DOCKERD_ROOTLESS_ROOTLESSKIT_NET=slirp4netns
Environment=DOCKERD_ROOTLESS_ROOTLESSKIT_PORT_DRIVER=builtin
ExecStartPre=/usr/bin/mkdir -p %t/tempo-staging %h/.local/share/tempo-staging %h/.local/share/tempo-staging/docker %h/.local/state/tempo-staging %h/.local/state/tempo-staging/docker-exec
ExecStartPre=/usr/bin/chmod 700 %t/tempo-staging %h/.local/share/tempo-staging %h/.local/share/tempo-staging/docker %h/.local/state/tempo-staging %h/.local/state/tempo-staging/docker-exec
ExecStart=%h/bin/dockerd-rootless.sh --host=unix://%t/tempo-staging/docker.sock --data-root=%h/.local/share/tempo-staging/docker --exec-root=%h/.local/state/tempo-staging/docker-exec --pidfile=%h/.local/state/tempo-staging/docker.pid --storage-driver=fuse-overlayfs
ExecReload=/bin/kill -s HUP $MAINPID
KillMode=mixed
Delegate=yes
Restart=on-failure
RestartSec=5s
TimeoutStartSec=120s
UMask=0077
LimitNOFILE=1048576

[Install]
WantedBy=default.target
