# Production: rootful Docker, served at http://127.0.0.1:8080/.
# shellcheck shell=bash disable=SC2034
COMPOSE_PROJECT=tempo-api-production
COMPOSE_FILE=/etc/tempo/compose/production.compose.yml
ENV_FILE=/etc/tempo/production.env
IMAGES_FILE=/var/lib/tempo-deploy/deployed.env
DOCKER_HOST=unix:///var/run/docker.sock
DOCKER_CONFIG=/var/lib/tempo-deploy/docker-config
STATE_DIR=/var/lib/tempo-deploy
DEFAULT_TAG=main
HEALTH_URLS="http://127.0.0.1:8080/api/health http://127.0.0.1:8080/"
# Services pinned by tag@digest in the Compose files; recreated when the pin changes.
PINNED_SERVICES="postgres redis"
TAILSCALE_COMPOSE_FILE=/etc/tempo/compose/tailscale.compose.yml
# Runs before an API or PostgreSQL image change; a failed backup cancels it. Migrations are never rolled back.
BEFORE_DATA_CHANGE="BACKUP_DIR=/var/lib/tempo-deploy/pre-deploy-backups KEEP=5 /usr/local/lib/tempo-deploy/backup.sh"
AFTER_DEPLOY=
