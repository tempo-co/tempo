# Built from the repository root. The web app imports `@tempo/contracts` from `../../packages/contracts/src`, so it
# sits two levels above the app directory here too.
FROM node:26-alpine AS builder
WORKDIR /usr/src/app

COPY packages/contracts/ /usr/packages/contracts/
COPY apps/web/package*.json ./
RUN npm ci

COPY apps/web/ ./

ARG VITE_API_URL=/api
ARG VITE_BASE_PATH=/
ENV VITE_API_URL=$VITE_API_URL \
    VITE_BASE_PATH=$VITE_BASE_PATH

RUN npm run build

FROM nginx:alpine
COPY --from=builder /usr/src/app/dist /usr/share/nginx/html
COPY apps/web/nginx/security-headers.conf /etc/nginx/snippets/tempo-security-headers.conf
COPY apps/web/nginx/tempo.conf /etc/nginx/conf.d/default.conf

EXPOSE 8080
