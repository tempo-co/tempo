FROM node:20-alpine AS builder
WORKDIR /usr/src/app

COPY package*.json ./
RUN npm ci

COPY . ./

ARG VITE_API_URL=/tempo/api
ARG VITE_BASE_PATH=/tempo/
ENV VITE_API_URL=$VITE_API_URL \
    VITE_BASE_PATH=$VITE_BASE_PATH

RUN npm run build

FROM nginx:alpine
COPY --from=builder /usr/src/app/dist /usr/share/nginx/html
RUN mkdir -p /etc/nginx/snippets
COPY nginx/security-headers.conf /etc/nginx/snippets/tempo-security-headers.conf
ARG NGINX_CONFIG=tempo.conf
COPY nginx/$NGINX_CONFIG /etc/nginx/conf.d/default.conf

EXPOSE 8080
