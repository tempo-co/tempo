FROM node:20-alpine AS builder
WORKDIR /usr/src/app

COPY package*.json ./
RUN npm ci

COPY . ./

ARG VITE_API_URL=/tempo/api
ARG VITE_BASE_PATH=/tempo/
ENV VITE_API_URL=$VITE_API_URL \
    VITE_BASE_PATH=$VITE_BASE_PATH

RUN npm run build

FROM nginx:alpine
COPY --from=builder /usr/src/app/dist /usr/share/nginx/html
COPY nginx/tempo.conf /etc/nginx/conf.d/default.conf

EXPOSE 8080
