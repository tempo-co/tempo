  "components": [
    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "The single most important local action. Clay-on-dark fill on the dark canvas; Clay strong on light.",
      "html": "<button class=\"ds-btn-primary\">Connect a bank</button>",
      "css": ".ds-btn-primary { background: hsl(var(--primary, 17.5 67.1% 69%)); color: hsl(var(--primary-foreground, 252 10.2% 9.6%)); padding: 8px 16px; min-height: 40px; border: 0; border-radius: 6px; font: 500 14px/20px Inter Variable, Inter, sans-serif; transition: color 160ms ease, background-color 160ms ease, border-color 160ms ease, transform 160ms cubic-bezier(0.23, 1, 0.32, 1); } .ds-btn-primary:hover { background: color-mix(in srgb, hsl(var(--primary, 17.5 67.1% 69%)) 90%, transparent); } .ds-btn-primary:focus-visible { outline: 2px solid hsl(var(--ring, 17.5 67.1% 69%)); outline-offset: 2px; } @media (max-width: 639px), (pointer: coarse) { .ds-btn-primary { min-height: 44px; min-width: 44px; } } @media (prefers-reduced-motion: no-preference) and (pointer: coarse) { .ds-btn-primary:active:not(:disabled) { transform: scale(0.97); } } @media (prefers-reduced-motion: reduce) { .ds-btn-primary { transition: none; } }"
    },
    {
      "name": "Search Input",
      "kind": "input",
      "refersTo": "input",
      "description": "A quiet field for search and filters.",
      "html": "<input class=\"ds-input-search\" placeholder=\"Search transactions...\" aria-label=\"Search transactions\" />",
      "css": ".ds-input-search { width: 100%; height: 40px; padding: 8px 12px; border: 1px solid hsl(var(--input, 270 6.9% 22.7%)); border-radius: 6px; background: hsl(var(--background, 252 10.2% 9.6%)); color: hsl(var(--foreground, 38.6 31.8% 91.4%)); font: 400 16px/24px Inter Variable, Inter, sans-serif; } .ds-input-search::placeholder { color: hsl(var(--muted-foreground, 36 9.2% 68%)); } .ds-input-search:focus-visible { outline: 2px solid hsl(var(--ring, 17.5 67.1% 69%)); outline-offset: 2px; } @media (min-width: 768px) { .ds-input-search { font-size: 14px; line-height: 20px; } }"
    },
    {
      "name": "Grouped Surface",
      "kind": "card",
      "refersTo": "card",
      "description": "A bordered, quiet surface for information that belongs together.",
      "html": "<section class=\"ds-card\"><h2>Connected bank</h2><p>Last synchronized recently</p></section>",
      "css": ".ds-card { padding: 24px; border: 1px solid hsl(var(--border, 270 6.9% 22.7%)); border-radius: 12px; background: hsl(var(--card, 260 9.1% 12.9%)); color: hsl(var(--foreground, 38.6 31.8% 91.4%)); box-shadow: 0 1px 2px 0 rgb(0 0 0 / 0.05); font-family: Inter Variable, Inter, sans-serif; } .ds-card h2 { font-size: 16px; font-weight: 600; margin: 0 0 4px; } .ds-card p { font-size: 14px; color: hsl(var(--muted-foreground, 36 9.2% 68%)); margin: 0; }"
    },
    {
      "name": "Status Badge",
      "kind": "chip",
      "refersTo": "status-badge",
      "description": "Compact text-first context for a categorical state.",
      "html": "<span class=\"ds-status-badge\">AUTHORIZED</span>",
      "css": ".ds-status-badge { display: inline-flex; align-items: center; padding: 2px 10px; border: 1px solid hsl(var(--border, 270 6.9% 22.7%)); border-radius: 9999px; background: transparent; color: hsl(var(--foreground, 38.6 31.8% 91.4%)); font: 600 12px/16px Inter Variable, Inter, sans-serif;  }"
    },
    {
      "name": "Quiet Navigation Item",
      "kind": "nav",
      "refersTo": "button-ghost",
      "description": "A 48px desktop header destination with a Clay underline on the active route; phones use a fixed bottom tab bar.",
      "html": "<a class=\"ds-nav-item\" href=\"#transactions\" aria-current=\"page\">Transactions</a>",
      "css": ".ds-nav-item { position: relative; display: inline-flex; align-items: center; min-height: 48px; padding: 0 12px; color: hsl(var(--foreground, 38.6 31.8% 91.4%)); font: 500 14px/20px Inter Variable, Inter, sans-serif; text-decoration: none; } .ds-nav-item[aria-current=\"page\"]::after { content: \"\"; position: absolute; inset-inline: 12px; bottom: 0; height: 2px; background: hsl(var(--primary, 17.5 67.1% 69%)); } .ds-nav-item:hover { color: hsl(var(--foreground, 38.6 31.8% 91.4%)); } .ds-nav-item:focus-visible { outline: 2px solid hsl(var(--ring, 17.5 67.1% 69%)); outline-offset: -2px; }"
    }
  ],
  "narrative": {
    "northStar": "",
    "overview": "Tempo is a private personal-finance overview and account tracker: balances, transactions, categories, and cash movement in one calm view. The interface is quiet and trustworthy, data-forward without density for its own sake, and distinctive through proportion, spacing, and a small number of deliberate forms — never through effects.\n\nThe authenticated product is primarily an **Operate** experience: a screen should make the current financial state, the next useful action, and the path to inspect detail obvious. Make state, task, and next action clear before adding visual personality.",
    "keyCharacteristics": [],
    "rules": [
      {
        "name": "The Quiet Signal Rule",
        "body": "Tempo earns attention with hierarchy and relevance first. Color, motion, and ornament are supporting signals, never the content of the screen.",
        "section": "overview"
      },
      {
        "name": "The One Accent Rule",
        "body": "Clay is scarce enough to remain meaningful. A screen has a clear primary action or active state, not a clay wash.",
        "section": "colors"
      },
      {
        "name": "The Plain Number Rule",
        "body": "Monetary values and dates stay easy to scan, compare, and copy.",
        "section": "typography"
      },
      {
        "name": "The Record Before Ornament Rule",
        "body": "The financial record is the visual subject. No decorative headers, metric-tile mosaics, or hero space before the data.",
        "section": "layout"
      }
    ],
    "dos": [
      "Make state, task, and next action clear before visual personality.",
      "Treat Clay as a scarce, meaningful signal on a paper/ink field.",
      "Verify dark, light, and system themes, keyboard focus, reduced motion, and narrow widths before calling a surface finished.",
      "Use real product terminology and honest data states; label synthetic data as synthetic."
    ],
    "donts": [
      "Don't use blue/violet gradients, glassmorphism, glowing borders, or metric-tile rows.",
      "Don't make every section a card or every action a pill.",
      "Don't introduce a second accent color or decorative gradients without a product reason.",
      "Don't fabricate balances, transactions, financial claims, or synchronization outcomes.",
      "Don't change typography, the radius vocabulary, or theme behavior as a side effect."
    ]
  }
}
