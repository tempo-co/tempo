{
  "name": "tempo-web",
  "private": true,
  "license": "UNLICENSED",
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=26.0.0",
    "npm": ">=10.8.2"
  },
  "scripts": {
    "generate-routes": "tsr generate",
    "dev": "tsr generate && vite",
    "build": "tsr generate && tsc -b && vite build",
    "format": "prettier --write \"src/**/*.{js,jsx,ts,tsx}\"",
    "format:check": "prettier --check \"src/**/*.{js,jsx,ts,tsx}\"",
    "lint": "eslint \"{src,test}/**/*.{ts,tsx}\" --report-unused-disable-directives --max-warnings 0 --fix",
    "lint:check": "eslint \"{src,test}/**/*.{ts,tsx}\" --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview --port 5173",
    "db:seed:e2e": "docker compose -p tempo-web -f docker-compose.e2e.yml exec -T api node ./dist/scripts/seed.js",
    "test:e2e:local": "npm run docker:test:down && npm run docker:test:up && npm run db:seed:e2e && npx playwright test",
    "docker:test:up": "docker compose -p tempo-web -f docker-compose.e2e.yml up -d --wait",
    "docker:test:down": "docker compose -p tempo-web -f docker-compose.e2e.yml down -v --remove-orphans"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@hookform/resolvers": "^5.9.2",
    "@radix-ui/react-checkbox": "^1.4.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-scroll-area": "^1.4.0",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-separator": "^1.2.0",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-toggle": "^1.2.1",
    "@radix-ui/react-toggle-group": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@tanstack/query-async-storage-persister": "^5.104.5",
    "@tanstack/react-query": "^5.104.5",
    "@tanstack/react-query-persist-client": "^5.104.5",
    "@tanstack/react-router": "^1.170.46",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/zod-adapter": "^1.167.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^3.6.0",
    "framer-motion": "^14.6.0",
    "input-otp": "^1.5.0",
    "lucide-react": "^1.61.0",
    "next-themes": "^0.4.6",
    "react": "^19.3.1",
    "react-day-picker": "^8.10.2",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.90.0",
    "recharts": "^3.10.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "vaul": "^1.1.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
