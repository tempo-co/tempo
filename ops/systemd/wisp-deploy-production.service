# Installed by `sudo ops/install.sh production`, which fills in @USER@.
[Unit]
Description=Deploy the latest tested Wisp images to production
OnFailure=wisp-failure-email@%n.service
# Image-pin bumps from main land first; if that step fails, the deploy still runs.
Wants=network-online.target wisp-sync-pins.service
After=docker.service network-online.target wisp-sync-pins.service
Requires=docker.service

[Service]
Type=oneshot
User=@USER@
SupplementaryGroups=docker
ExecStart=/usr/local/lib/wisp-deploy/deploy.sh production
# Worst case: pulls, pre-deploy backup, then a failed rollout and its rollback (~13 min of health waits).
TimeoutStartSec=30min
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/var/lib/wisp-deploy
