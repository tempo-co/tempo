# Installed by `sudo ops/install.sh production`. Reload after installing or after recreating a filtered network.
[Unit]
Description=Limit what the Tempo API uid and containers can reach
Wants=docker.service
After=docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/sbin/tempo-api-egress
ExecReload=/usr/local/sbin/tempo-api-egress
ExecStop=/usr/sbin/nft delete table inet tempo_api_egress
TimeoutStartSec=60

[Install]
WantedBy=multi-user.target
