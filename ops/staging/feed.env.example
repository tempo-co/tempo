# Where `tempo-staging-refresh.sh refresh` takes production data from. Copy to ~/.config/tempo-staging/feed.env.
# server-copy: the production server's encrypted owner-only copy, fetched over the tailnet (see README, Database feed).
# local-backups (also when this file or the setting is missing): the newest tempo-YYYYMMDD-HHMMSS.dump in ~/backups/tempo.
STAGING_FEED=server-copy
# The server's staging feed account, user@host on the tailnet.
STAGING_FEED_SSH=wisp-staging-feed@wisp-production.example.ts.net
