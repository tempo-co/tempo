# Staging: isolated rootless Docker daemon, loopback-only at http://127.0.0.1:8119/.
# shellcheck shell=bash disable=SC2034
COMPOSE_PROJECT=tempo-staging
COMPOSE_FILE=$HOME/.config/tempo-staging/staging.compose.yml
ENV_FILE=$HOME/.config/tempo-staging/staging.env
# The refresh script reads the deployed images from staging.env, so they are kept there.
IMAGES_FILE=$ENV_FILE
DOCKER_HOST=unix://${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/tempo-staging/docker.sock
DOCKER_CONFIG=$HOME/.config/tempo-staging/docker-config
STATE_DIR=$HOME/.local/state/tempo-staging
# Empty: a component without --api/--web keeps its current image.
DEFAULT_TAG=
HEALTH_URLS="http://127.0.0.1:8119/api/health http://127.0.0.1:8119/"
BEFORE_API_CHANGE=
AFTER_DEPLOY="$HOME/.config/tempo-staging/tempo-staging-refresh.sh refresh --confirm-production-backup-refresh"
